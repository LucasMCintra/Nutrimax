APP_NAME=Nutrimax API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrimax
API_V1_PREFIX=/api/v1
# Nunca versione uma chave real. Configure-a apenas em backend/.env ou no secret manager do ambiente.
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=120
# Use 0 para não repetir chamadas e controlar a quota. Aumente apenas se necessário.
GEMINI_MAX_RETRIES=0
GEMINI_RETRY_BACKOFF_SECONDS=2
MAX_IMAGE_SIZE_BYTES=5242880
MAX_IMAGE_DIMENSION=1920
THUMBNAIL_DIMENSION=250
MAX_UPLOADS_PER_USER=50

