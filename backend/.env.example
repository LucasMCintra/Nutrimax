APP_NAME=Nutrimax API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrimax
API_V1_PREFIX=/api/v1
# Nunca versione uma chave real. Configure-a apenas em backend/.env ou no secret manager do ambiente.
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=60
